# Payback — environment variables
#
# Every variable here is one the app genuinely needs to run locally and against
# a real Nimiq Pay + Convex + Albatross environment. Nothing below is a guessed
# placeholder; see DECISIONS.md for the reasoning behind each one, and see
# SECURITY.md Section 1 for why NO key/secret/seed-phrase variable appears here
# at all — the app never holds one, so there is nothing to configure for it.

# --- Convex (backend: requests/participants/payment_events + confirmation job) ---

# Set automatically by `npx convex dev` / `npx convex deploy`. Identifies which
# Convex deployment this project's functions and schema are pushed to.
CONVEX_DEPLOYMENT=

# The Convex deployment's public client URL. Consumed by the Vite frontend
# (Convex's React client reads this at build/run time). Must be prefixed
# VITE_ so Vite exposes it to client code.
VITE_CONVEX_URL=

# --- App identity (used by RequestLinkGenerator to build shareable links) ---

# The app's own publicly reachable domain, exactly as it will be registered
# with Nimiq Pay. Used to construct both documented deeplink formats:
#   nimiqpay://miniapp?url=<VITE_APP_URL>
#   https://nimpay.app/miniapps/open/<VITE_APP_URL>
# (formats verified against nimiq.dev — see PRD.md Section 0)
VITE_APP_URL=

# --- Nimiq network (used only by the Convex confirmation job — PRD Section 5.4) ---

# Which Albatross network to poll: mainnet or testnet. Not used by the
# frontend — the Nimiq provider itself (injected by Nimiq Pay) already knows
# which network the connected wallet is on; this only controls which network
# the backend confirmation job checks transactions against.
NIMIQ_NETWORK=testnet

# Albatross JSON-RPC endpoint the confirmation job polls (getTransactionByHash)
# to independently verify a broadcast transaction actually landed on-chain
# before the app is allowed to say "Paid" (SECURITY.md Section 4).
#
# IMPORTANT: no official Nimiq-hosted public RPC endpoint is documented
# (verified against nimiq.dev during planning — see DECISIONS.md, item 6).
# This must point at either a self-run Albatross node's RPC interface or a
# trusted third-party RPC provider. There is no safe default to put here.
NIMIQ_RPC_URL=

# --- Explicitly NOT present, and why ---
# - No NIMIQ_API_KEY / NIMIQ_CLIENT_SECRET: the Mini App SDK provider is
#   injected into the WebView by Nimiq Pay itself; there is no API key the
#   app authenticates with (nimiq.dev/mini-apps/tutorials/mini-app-tutorial).
# - No wallet private key / seed phrase variable, of any name, under any
#   circumstance: SECURITY.md Section 1 — this app never touches key
#   material, so there is nothing to configure here. If a future change
#   seems to need one, that change is out of scope, not a missing env var.
